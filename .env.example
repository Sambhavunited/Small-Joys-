# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables, then redeploy.

# --- AI assistant (Joy) ---
# Without this key Joy runs in "guided mode" (rule-based replies that still
# build gift boxes and hand orders to WhatsApp).
ANTHROPIC_API_KEY=
# Optional: model and effort (low | medium | high). Defaults: claude-opus-5-5, low.
ANTHROPIC_MODEL=
AGENT_EFFORT=

# --- Lead inbox (/admin) ---
ADMIN_PASSWORD=
# Optional extra secret mixed into the sign-in cookie signature.
ADMIN_SECRET=

# --- Lead storage ---
# Added automatically when a Vercel Blob store is connected to the project.
# Without it, leads are kept in memory only (fine for local testing).
BLOB_READ_WRITE_TOKEN=

# --- Instant alerts for hot and confirmed leads (optional) ---
# Email via Resend (https://resend.com)
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# Phone push via the free ntfy app (https://ntfy.sh): pick a long, random topic name
NTFY_TOPIC=

# --- Site ---
# Public URL once you have a custom domain, e.g. https://smalljoys.in
NEXT_PUBLIC_SITE_URL=
# WhatsApp number in international format without "+" (default 919555548126)
NEXT_PUBLIC_WHATSAPP_NUMBER=
